# Production placeholder values only.
# Copy this file to .env.production on the server and edit it there.
# The real .env.production file must stay server-local and must never be
# committed, pasted into tickets, or printed in logs.

APP_NAME=barong-ops-console-backend
APP_ENV=production
APP_DEBUG=false
APP_DOCS_ENABLED=false
APP_VERSION=0.1.0

# POSTGRES_PASSWORD and the password inside DATABASE_URL must match.
# URL-encode special characters in DATABASE_URL passwords.
POSTGRES_DB=barong_ops_console
POSTGRES_USER=barong_ops_console
POSTGRES_PASSWORD=CHANGE-ME-strong-random-postgres-password
DATABASE_URL=postgresql+psycopg://barong_ops_console:CHANGE-ME-url-encoded-postgres-password@console_postgres:5432/barong_ops_console

# OWNER_PASSWORD is used only for the first owner bootstrap command.
# After the owner is created, clear this value from the server-local
# .env.production file and recreate the backend/frontend containers.
OWNER_USERNAME=CHANGE-ME-owner-username
OWNER_PASSWORD=CHANGE-ME-bootstrap-owner-password

# Server-side container URL used by the Next.js API proxy. Do not expose
# credentials in this URL.
BACKEND_API_URL=http://console_backend:8000

# Browser-visible public console origin. The current UI uses the same-origin
# proxy first, but this must still be a non-secret public URL.
NEXT_PUBLIC_API_BASE_URL=https://ops.barongyekhna.com
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=600
DB_STATEMENT_TIMEOUT_MS=8000
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=8000

# C19 Record Store client. The token must match C19_RECORD_SERVICE_TOKEN in the
# separately protected Record Service env file; never commit either real value.
C19_RECORD_STORE_URL=http://c19-record-service:8090
C19_RECORD_STORE_TOKEN=CHANGE-ME-independent-strong-random-c19-service-token
C19_RECORD_STORE_TIMEOUT_SECONDS=5
C19_RECORD_EVENT_POLL_SECONDS=1
C19_EVENT_STREAM_LIFETIME_SECONDS=20
C19_RATE_LIMIT_WINDOW_SECONDS=60
C19_WRITE_USER_RATE_LIMIT_ATTEMPTS=180
C19_WRITE_IP_RATE_LIMIT_ATTEMPTS=1800
C19_STREAM_USER_RATE_LIMIT_ATTEMPTS=30
C19_STREAM_IP_RATE_LIMIT_ATTEMPTS=300

# C19 Asset Store client. Stage 4 isolated acceptance is complete; keep these
# blank until the separate reviewed production/Nginx activation. Only
# console_backend may receive them.
C19_ASSET_STORE_URL=
C19_ASSET_STORE_TOKEN=
C19_ASSET_STORE_TIMEOUT_SECONDS=10

# Production cookies are enforced by backend policy even if these are mis-set.
AUTH_SESSION_COOKIE_PATH=/api/backend
AUTH_SESSION_COOKIE_SAMESITE=none
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_COOKIE_DOMAIN=

# Keep these empty until a separate approved test/demo n8n workflow is created.
# Do not point production at a real n8n business workflow in C01B.
N8N_TEST_WEBHOOK_URL=
N8N_TEST_CALLBACK_SECRET=
N8N_TEST_REQUEST_TIMEOUT_SECONDS=10

# WooCommerce category control-plane sync. Inject the real WordPress application
# password only in the server-local .env.production file.
WP_BASE_URL=
WP_APP_USER=
WP_APP_PASSWORD=
WP_REQUEST_TIMEOUT_SECONDS=10
WP_REQUEST_MAX_ATTEMPTS=3
# Public CS contact-form ingress. Keep the real shared key server-local.
CS_INBOUND_KEY=

# C16-FIX-4 production security hardening defaults.
WEBHOOK_GATEWAY_SIGNING_SECRET=CHANGE-ME-strong-random-webhook-signing-secret
WEBHOOK_REPLAY_NONCE_TTL_SECONDS=900
CONTROL_PLANE_STEALTH_MODE=true
LOGIN_IP_RATE_LIMIT_ATTEMPTS=20
LOGIN_USER_RATE_LIMIT_ATTEMPTS=10
LOGIN_ENDPOINT_RATE_LIMIT_ATTEMPTS=200
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_FAILED_ATTEMPT_LOCKOUT_THRESHOLD=5
LOGIN_FAILED_ATTEMPT_BASE_DELAY_SECONDS=2
LOGIN_FAILED_ATTEMPT_MAX_DELAY_SECONDS=60
LOGIN_ACCOUNT_LOCKOUT_MINUTES=15
