# Local environment files and production secrets.
.env
.env.local
.env.staging
.env.production
.env.c19-record.*
!.env.c19-record.*.example
.env.c19-asset.*
!.env.c19-asset.*.example
.env.*.local

# Secret material must stay outside Git. Commit only explicit *.example files.
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*secret*
*secrets*

# Source files for the R System secret-management feature. These contain no
# secret material; the broad patterns above protect runtime secret files.
!r_system_v2/core/secret_manager.py
!backend/app/api/routes/r_system_secrets.py
!backend/app/models/r_system_secret.py
!backend/alembic/versions/20260702_01_r_system_secret_manager.py
!frontend/src/lib/r-system-secrets-api.ts
!frontend/src/components/r-system-secret-management-panel.tsx
!scripts/r_secret_manager_e2e.py
!tests/backend/test_r_system_secret_manager.py
!R_SECRET_MANAGER_E2E_REPORT.json

# Python and test caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node and Next.js build output.
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo

# Runtime-only C19 record archives contain private chat content.
backups/c19-record/
backups/c19-asset/
*.dump
*.dump.metadata

# Local editor and OS files.
.DS_Store
.idea/
.vscode/
*.swp

# Local cold backups (serpbear decommission etc.) must stay out of Git.
backups/
