# Local environment files and production secrets.
.env
.env.local
.env.staging
.env.production
.env.c19-record.*
!.env.c19-record.*.example
.env.c19-asset.*
!.env.c19-asset.*.example
.env.*.local

# Secret material must stay outside Git. Commit only explicit *.example files.
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*secret*
*secrets*

# Source files for the R System secret-management feature. These contain no
# secret material; the broad patterns above protect runtime secret files.
!r_system_v2/core/secret_manager.py
!backend/app/api/routes/r_system_secrets.py
!backend/app/models/r_system_secret.py
!backend/alembic/versions/20260702_01_r_system_secret_manager.py
!frontend/src/lib/r-system-secrets-api.ts
!frontend/src/components/r-system-secret-management-panel.tsx
!scripts/r_secret_manager_e2e.py
!tests/backend/test_r_system_secret_manager.py
!R_SECRET_MANAGER_E2E_REPORT.json

# Python and test caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node and Next.js build output.
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo

# Runtime-only C19 record archives contain private chat content.
backups/c19-record/
backups/c19-asset/
*.dump
*.dump.metadata

# Local editor and OS files.
.DS_Store
.idea/
.vscode/
*.swp

# Local cold backups (serpbear decommission etc.) must stay out of Git.
backups/

# One-off WP diagnostic plugin (bkismet signup debug) — keep on disk, out of Git.
backend/app/modules/p_series/wordpress/plugins/barong-hookdump.php

# GEO working photos (harvested/incoming/webp) — tens of MB of binaries, stay on disk.
geo-photos/

# 真密钥文件的「备份/变体」。上面那几条是**精确文件名**,不覆盖
# `.env.production.bak-...` 这类。2026-09-02 实地发现两个这样的文件躺在工作树里:
# 未被跟踪、但也未被忽略 —— 分别含 13 行和 9 行密钥,且与当时生产 100% 相同,
# 一次 `git add -A` 就会连同明文密码提交进备份仓库。
# 这是个多头共用的工作树,所以「没人会那么做」不成立。
.env.production.*
!.env.production.example
.env.staging.*
!.env.staging.example
.env.*.bak
.env.*.bak-*

# 运行时与构建产物 —— 2026-09-03 补。这些目录此前「未跟踪但也未忽略」,
# 一次 `git add -A` 就会把它们连同 216MB 的客户端安装包一起提交进来。
#
# `migration_manifest.json` **不在此列**:它是被有意跟踪的校验清单,
# `scripts/staging_stabilization.py` 读它核对 alembic head。
_uploads/
var/
tmp/
releases/
