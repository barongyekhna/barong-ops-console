    "must_not_do": [
      "do not expose n8n or webhook runtime URL directly to the frontend",
      "do not return plaintext API keys to the frontend",
      "do not carry secret/token/authorization fields in execution payloads",
      "do not bypass org membership and module binding checks",
      "do not depend on removed jobs/artifacts/workflows routes"
