  "k_series_integration_notes": {
    "must_reuse": [
      "module manifest or module_registry",
      "permission_registry and unified permission engine",
      "org_memberships and module_bindings",
      "module_control_states",
      "api_key_orchestration for external credentials",
      "module_execution_gate or execution_flow_gate",
      "webhook_gateway and callback_handler for signed ingress/callback",
      "capability bootstrap and frontend route guard"
