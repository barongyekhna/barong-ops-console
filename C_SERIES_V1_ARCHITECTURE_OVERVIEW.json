  "execution_gates": {
    "c13e_execution_flow_gate": {
      "file": "backend/app/services/execution_flow_gate.py",
      "flow": [
        "C08 Module Adapter",
        "C13E Execution Flow Gate",
        "C12 Approval Gate",
        "C14 External Dependency Gate",
        "C09 Execution Provider",
        "C10 Sandbox"
      ],
      "checks": [
        "emergency kill switch",
        "identity validity",
        "module switch runtime gate",
        "sandbox envelope",
        "adapter action contract",
        "approval gate",
        "external dependency gate",
        "provider readiness",
        "sandbox runtime status",
        "secret binding",
        "mock/staging/live mode"
      ]
    },
    "module_execution_gate": {
      "file": "backend/app/services/module_execution_gate.py",
      "used_by": [
        "integration.n8n_test_bridge",
        "integration.n8n_webhook_test_bridge"
      ],
      "responsibilities": [
        "resolve org context",
        "normalize legacy module ids",
        "validate registered module",
        "ensure or read module control state",
        "block disabled or error modules",
        "resolve required API key bindings",
        "emit execution gate events"
      ],
      "missing_key_error_code": "API_KEY_BINDING_MISSING"
    },
    "live_gate": {
      "route_prefix": "/api/control-plane/live-gate",
      "permission": "GOVERNANCE.admin",
      "files": [
        "backend/app/api/routes/live_gate.py",
        "backend/app/services/live_gating.py",
        "backend/app/services/pre_live_validation.py"
      ],
      "live_requirements": [
        "C12 unlock",
        "canary routed live",
        "pre-live validation passed",
        "global live switch",
        "active enabled org policy",
        "active enabled module policy",
        "not staging_only"
      ]
    }
  },
  "webhook_n8n": {
    "webhook_gateway": {
      "route": "POST /api/control-plane/webhook-gateway/ingress",
      "route_file": "backend/app/api/routes/webhook_gateway.py",
      "service_file": "backend/app/services/webhook_gateway.py",
      "permission": "internal C15B",
      "signature": {
        "header": "X-Barong-Gateway-Signature",
        "format": "sha256=<hex>",
        "algorithm": "HMAC-SHA256",
        "secret": "WEBHOOK_GATEWAY_SIGNING_SECRET",
        "timestamp_tolerance_seconds_default": 300,
        "replay_nonce_ttl_seconds_default": 900
      },
      "dispatches_to_n8n": false,
      "payload_policy": {
        "forbids_secret_fields": true,
        "forbids_runtime_urls": true,
        "forbids_direct_authorization_values": true
      }
    },
    "callback_handler": {
      "route_prefix": "/api/control-plane/callback-handler",
      "routes": [
        "POST /receiver",
        "POST /context-bindings",
        "GET /results/{context_id}"
      ],
      "signature_model": "same gateway signature header and secret",
      "tables": [
        "callback_state",
        "callback_state_transitions",
        "execution_callbacks",
        "execution_results"
      ]
    },
    "n8n_test_bridge": {
      "module": "integration.n8n_test_bridge",
      "route_file": "backend/app/api/routes/n8n_test.py",
