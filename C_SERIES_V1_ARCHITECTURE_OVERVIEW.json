  "module_control": {
    "api": {
      "read_center": "GET /api/control-plane/module-control/center",
      "update_state": "PATCH /api/control-plane/module-control/organizations/{org_id}/registry-entries/{module_id}"
    },
    "implementation": {
      "route": "backend/app/api/routes/module_control.py",
      "builder": "backend/app/services/module_control_center.py",
      "cache": "backend/app/services/module_control_cache_service.py",
      "model": "backend/app/models/module_control.py"
    },
    "permissions": {
      "read": "lightweight cached control-plane admin",
      "write": "owner only"
    },
    "state_table": "module_control_states",
    "state_defaults": {
      "missing_state_on_read": "represented as enabled active without writing a row",
      "missing_state_on_update": "created by update operation",
      "enabled_true_runtime_status": "active",
      "enabled_false_runtime_status": "disabled"
    },
    "cache": {
      "ttl_seconds": 5,
      "refresh_interval_seconds": 5,
      "wait_timeout_seconds": 0.5,
      "scope": "per backend worker process"
    }
  },
  "api_key_management": {
    "routes_prefix": "/api/control-plane/api-key-orchestration",
    "route_file": "backend/app/api/routes/api_key_orchestration.py",
    "service_file": "backend/app/services/api_key_orchestration.py",
    "models_file": "backend/app/models/api_keys.py",
    "frontend_api_file": "frontend/src/lib/api-key-orchestration-api.ts",
    "permission": "owner only",
    "tables": [
      "api_key_records",
      "api_key_module_bindings"
    ],
    "encryption": {
      "envelope_prefix": "akv1",
      "nonce_bytes": 16,
      "mac": "HMAC-SHA256",
      "cipher": "HMAC-SHA256 keystream XOR",
      "secret_priority": [
        "API_KEY_ENCRYPTION_SECRET",
        "OWNER_PASSWORD",
        "DATABASE_URL"
      ]
    },
    "runtime_injection": {
      "resolver": "resolve_module_api_key_for_injection",
      "header_name": "Authorization",
      "header_value_format": "Bearer {secret}",
      "updates_last_used_at": true
    },
    "frontend_exposure_policy": {
      "returns_plaintext_key": false,
      "returns_ciphertext": false,
      "returns_fingerprint": false,
      "returns_hash_prefix": true
    }
  },
