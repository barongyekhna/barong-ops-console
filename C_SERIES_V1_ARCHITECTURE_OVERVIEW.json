      "config": [
        "N8N_TEST_WEBHOOK_URL",
        "N8N_TEST_CALLBACK_SECRET"
      ],
      "default_key_alias": "n8n",
      "http_client": "httpx",
      "retryable_statuses": [
        408,
        429,
        500,
        502,
        503,
        504
      ],
      "max_retries": 2
    }
