# Example values only. Never commit a real .env file or production credentials.
APP_NAME=barong-ops-console-backend
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://barong_console_example:barong_console_example@db:5432/barong_console_example
AUTH_SESSION_COOKIE_PATH=/api/backend
AUTH_SESSION_COOKIE_SAMESITE=lax
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_DOMAIN=
# Example placeholder only. Generate a different value for production.
AUTH_TOKEN_SECRET=example-only-change-me-at-least-32-characters-DO-NOT-USE-IN-PRODUCTION
AUTH_TOKEN_EXPIRE_MINUTES=60
OWNER_USERNAME=example_owner
# Example placeholder only. Never use this owner password in production.
OWNER_PASSWORD=example-only-owner-password-DO-NOT-USE-IN-PRODUCTION
# Example placeholder only. Must remain an explicitly test/demo webhook.
N8N_TEST_WEBHOOK_URL=https://n8n-test.example.invalid/webhook-test/barong-demo
# Example placeholder only. Replace without committing the real value.
N8N_TEST_CALLBACK_SECRET=example-only-n8n-test-callback-value-DO-NOT-USE
N8N_TEST_REQUEST_TIMEOUT_SECONDS=10
# Browser-visible example URL used by the Next.js authentication proxy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Example Compose-only container address. Must not contain credentials.
BACKEND_API_URL=http://backend:8000
# C16-FIX-4 local hardening defaults. Tune only in reviewed deployments.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=600
DB_STATEMENT_TIMEOUT_MS=8000
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=8000
WEBHOOK_REPLAY_NONCE_TTL_SECONDS=900
LOGIN_IP_RATE_LIMIT_ATTEMPTS=20
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_FAILED_ATTEMPT_LOCKOUT_THRESHOLD=5
LOGIN_FAILED_ATTEMPT_BASE_DELAY_SECONDS=2
LOGIN_FAILED_ATTEMPT_MAX_DELAY_SECONDS=60
LOGIN_ACCOUNT_LOCKOUT_MINUTES=15
