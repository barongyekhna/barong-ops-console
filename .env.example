# Example values only. Never commit a real .env file or production credentials.
APP_NAME=barong-ops-console-backend
APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://barong_console_example:barong_console_example@db:5432/barong_console_example
# Example placeholder only. Generate a different value for production.
AUTH_TOKEN_SECRET=example-only-change-me-at-least-32-characters-DO-NOT-USE-IN-PRODUCTION
AUTH_TOKEN_EXPIRE_MINUTES=60
OWNER_USERNAME=example_owner
# Example placeholder only. Never use this owner password in production.
OWNER_PASSWORD=example-only-owner-password-DO-NOT-USE-IN-PRODUCTION
# Browser-visible example URL used by the Next.js authentication proxy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Example Compose-only container address. Must not contain credentials.
BACKEND_API_URL=http://backend:8000
