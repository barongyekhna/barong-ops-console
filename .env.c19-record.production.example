# C19 Record Service placeholders only. Copy to `.env.c19-record.production`
# on the server, set mode 0600, and never commit or print the real file.

C19_RECORD_DATASET_ID=barong-c19-production
POSTGRES_DB=c19_chat_records
POSTGRES_USER=c19_record_service
# Use one URL-safe random value (for example, hex) in both password locations.
POSTGRES_PASSWORD=CHANGE-ME-same-url-safe-c19-postgres-password
C19_RECORD_DATABASE_URL=postgresql+psycopg://c19_record_service:CHANGE-ME-same-url-safe-c19-postgres-password@c19-record-postgres:5432/c19_chat_records

# This value must match C19_RECORD_STORE_TOKEN in `.env.production`.
C19_RECORD_SERVICE_TOKEN=CHANGE-ME-independent-strong-random-c19-service-token
C19_RECORD_CURSOR_SIGNING_SECRET=CHANGE-ME-independent-c19-cursor-signing-secret
C19_RECORD_CURSOR_TTL_SECONDS=86400
C19_RECORD_MAX_MESSAGE_CHARS=10000
