[Unit]
Description=Barong authenticated VPN member gateway
After=network-online.target barong-vpn-bridge.service
Wants=network-online.target barong-vpn-bridge.service

[Service]
Type=simple
User=barong-vpn-gateway
Group=barong-vpn-gateway
WorkingDirectory=/opt/barong-ops-console
LoadCredential=agent-token:/etc/barong-vpn-gateway/agent-token
# Node registry (see deploy/vpn/nodes.example.json, docs/VPN_OPERATIONS.md).
LoadCredential=nodes:/etc/barong-vpn-gateway/nodes.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/barong-ops-console/backend/vpn_gateway.py --host 127.0.0.1 --port 18766
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
