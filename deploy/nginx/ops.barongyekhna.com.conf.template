# Template only. Do not install this file automatically and do not overwrite
# existing n8n, Filebrowser, MinIO, robot, or other production Nginx vhosts.
#
# Replace the certificate paths after HTTPS certificates have been issued.
# The map block belongs in the Nginx http context; most sites-enabled/conf.d
# include layouts are already loaded from http.

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ops.barongyekhna.com;

    # Optional ACME webroot location. Adjust the root to the reviewed local
    # ACME challenge directory before using it.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt-placeholder;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ops.barongyekhna.com;

    ssl_certificate /path/to/ops.barongyekhna.com/fullchain.pem;
    ssl_certificate_key /path/to/ops.barongyekhna.com/privkey.pem;

    client_max_body_size 10m;

    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src 'none'; upgrade-insecure-requests" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;

    # C15G Security & Isolation Layer.
    # These stealth-deny rules are template-only; review before installing.
    # They hide public webhook/n8n bypass paths before the request reaches Next.js.
    location ~* ^/(webhook|n8n)(/|$) {
        return 404;
    }

    location ~* ^/api/backend/(webhook|n8n)(/|$) {
        return 404;
    }

    location = /api/backend/webhook-gateway/ingress {
        return 404;
    }

    # W-S machine plane. Keep these locations exact: browser-facing W routes
    # continue through Next.js, while token/signature-authenticated callbacks
    # reach FastAPI without entering the frontend proxy allowlist.
    location ~ "^/w/sync/[0-9a-f]{32}/result$" {
        limit_except POST { deny all; }
        client_max_body_size 32k;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }

    location = /w/orders/ingest {
        limit_except POST { deny all; }
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }

    # K 外部精修通道(MCP):Codex 桌面版等外部代理经 Bearer token 直达 k-mcp
    # sidecar(127.0.0.1:8095)。Streamable HTTP 无状态模式也会发 GET;交稿是 base64
    # 图片,2K PNG 约 8-10MB,故放宽 body 上限。/files/* 靠 HMAC 签名 URL,不走 Bearer。
    location ^~ /mcp/k-images {
        limit_except POST GET DELETE { deny all; }
        client_max_body_size 32m;
        proxy_pass http://127.0.0.1:8095;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    location = /w/tracking/webhook {
        limit_except POST { deny all; }
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }

    # C19 event stream: do not buffer authenticated SSE pages.
    location = /api/backend/c19/events {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 60s;
    }

    # C19 Moment events use a separate content-free cursor stream and the same
    # bounded session revalidation policy as chat events.
    location = /api/backend/c19/moments/events {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 60s;
    }

    # A text/emoji message is at most 4,000 characters plus its JSON envelope.
    location ~ "^/api/backend/c19/conversations/conv_[0-9a-f]{32}/messages$" {
        client_max_body_size 16k;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # C19 asset authorization is a body-free subrequest to Barong. The current
    # login cookie and original opaque transfer path/method are the only browser
    # inputs. Barong rechecks either current conversation membership or current
    # Moment visibility on every byte request; neither Next.js nor Barong
    # receives the file body.
    location = /_c19_asset_transfer_auth {
        internal;
        proxy_pass http://127.0.0.1:8000/api/app/c19/assets/transfers/authorize;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        # The browser byte plane authenticates only with the normal session
        # cookie; do not let caller-supplied headers override that identity.
        proxy_set_header Authorization "";
        proxy_set_header X-Session-Token "";
        proxy_set_header X-C19-Transfer-URI $c19_transfer_uri;
        proxy_set_header X-C19-Transfer-Method $c19_transfer_method;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # A 32-byte random ticket is encoded as 43 base64url characters. Keep these
    # locations exact so malformed and provider-shaped paths fall through to the
    # explicit deny below. Do not enable access logging: the URI is a credential.
    location ~ "^/api/backend/c19-assets/u/[A-Za-z0-9_-]{43}$" {
        limit_except PUT { deny all; }
        access_log off;
        # auth_request itself is a GET subrequest. Freeze the client request
        # values before that subrequest so Barong sees the original PUT/path.
        set $c19_transfer_uri $request_uri;
        set $c19_transfer_method $request_method;
        client_max_body_size 64m;
        client_body_timeout 120s;
        auth_request /_c19_asset_transfer_auth;
        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The login credential is consumed only by the auth subrequest above.
        # The byte gateway receives the opaque transfer ticket, never Barong's
        # session or an upstream Authorization credential.
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header X-Session-Token "";
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location ~ "^/api/backend/c19-assets/d/[A-Za-z0-9_-]{43}$" {
        limit_except GET HEAD { deny all; }
        access_log off;
        set $c19_transfer_uri $request_uri;
        set $c19_transfer_method $request_method;
        auth_request /_c19_asset_transfer_auth;
        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header X-Session-Token "";
        proxy_set_header Connection "";
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
    }

    # This ordinary prefix is the fallback after the two regex locations above.
    # Do not add ^~: that modifier would suppress regex matching and deny every
    # otherwise valid upload/download ticket.
    location /api/backend/c19-assets/ {
        access_log off;
        return 404;
    }

    location = /api/backend/c19-assets {
        access_log off;
        return 404;
    }

    # Fail closed for pre-cookie-scope locators after the byte plane moved
    # below /api/backend. Stale clients must obtain a fresh control-plane
    # intent; never let an old ticket-shaped path fall through to Next.
    location = /api/c19-assets {
        access_log off;
        return 404;
    }

    location /api/c19-assets/ {
        access_log off;
        return 404;
    }

    include /opt/barong-ops-console/deploy/nginx/vpn-status-location.conf;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}
