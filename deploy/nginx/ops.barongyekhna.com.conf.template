# Template only. Do not install this file automatically and do not overwrite
# existing n8n, Filebrowser, MinIO, robot, or other production Nginx vhosts.
#
# Replace the certificate paths after HTTPS certificates have been issued.
# The map block belongs in the Nginx http context; most sites-enabled/conf.d
# include layouts are already loaded from http.

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ops.barongyekhna.com;

    # Optional ACME webroot location. Adjust the root to the reviewed local
    # ACME challenge directory before using it.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt-placeholder;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ops.barongyekhna.com;

    ssl_certificate /path/to/ops.barongyekhna.com/fullchain.pem;
    ssl_certificate_key /path/to/ops.barongyekhna.com/privkey.pem;

    client_max_body_size 10m;

    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src 'none'; upgrade-insecure-requests" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;

    # C15G Security & Isolation Layer.
    # These stealth-deny rules are template-only; review before installing.
    # They hide public webhook/n8n bypass paths before the request reaches Next.js.
    location ~* ^/(webhook|n8n)(/|$) {
        return 404;
    }

    location ~* ^/api/backend/(webhook|n8n)(/|$) {
        return 404;
    }

    location = /api/backend/webhook-gateway/ingress {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}
