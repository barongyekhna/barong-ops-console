          "id": "aPB82hXe9Rxdvyfo",
          "name": "WooCommerce"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 存在同 slug 则 PUT，否则 POST（编辑=upsert 天然覆盖）\nconst task = $('解析任务').first().json;\nconst found = ($input.all() || []).map(i => i.json).filter(j => j && j.slug === task.p.slug);\nconst existingId = task.p.woo_class_id || (found.length ? found[0].id : null);\nconst base = 'https://barongyekhna.com/wp-json/wc/v3/products/shipping_classes';\nreturn [{ json: {\n  ...task,\n  woo_method: existingId ? 'PUT' : 'POST',\n  woo_url: existingId ? `${base}/${existingId}` : base,\n  woo_body: { name: task.p.name, slug: task.p.slug, description: task.p.description || '' },\n} }];"
      },
      "id": "b5555555-5555-4555-8555-555555555555",
      "name": "定建改",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
