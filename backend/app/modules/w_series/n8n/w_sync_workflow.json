    {
      "parameters": {
        "jsCode": "// 找 flat_rate 实例 → 组 settings（基础运费 + 本类别附加 class_cost_{classId}）\nconst rateTask = $('匹配区域').first().json;\nconst methods = $input.all().map(i => i.json);\nconst flat = methods.find(m => m.method_id === 'flat_rate');\nif (!rateTask.zone_id || !flat) {\n  return [{ json: { ...rateTask, skip: true } }];\n}\nconst settings = {};\nif (rateTask.base_cost !== undefined && rateTask.base_cost !== null && rateTask.base_cost !== '') settings.cost = String(rateTask.base_cost);\nif (rateTask.class_cost !== undefined && rateTask.class_cost !== null && rateTask.class_cost !== '') settings['class_cost_' + rateTask.woo_class_id] = String(rateTask.class_cost);\nreturn [{ json: { ...rateTask, skip: false, instance_id: flat.instance_id, settings_body: { settings } } }];"
      },
