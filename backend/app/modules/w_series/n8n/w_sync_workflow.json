    {
      "parameters": {
        "jsCode": "// 记下 Woo class id；把区域费率摊平成待办（无费率则空跑直达回报）\nconst task = $('解析任务').first().json;\nconst wooClass = $input.first().json;\nconst wooClassId = wooClass.id || task.p.woo_class_id;\nconst rates = Array.isArray(task.p.zone_rates) ? task.p.zone_rates : [];\nreturn [{ json: { ...task, woo_class_id: wooClassId, zone_rates: rates, has_rates: rates.length > 0 } }];"
      },
      "id": "b7777777-7777-4777-8777-777777777777",
      "name": "记模板ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.has_rates }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "b8888888-8888-4888-8888-888888888888",
      "name": "有区域费率?",
      "type": "n8n-nodes-base.if",
