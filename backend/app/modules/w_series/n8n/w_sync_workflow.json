      "id": "b9999999-9999-4999-8999-999999999999",
      "name": "查区域",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1720,
        60
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "aPB82hXe9Rxdvyfo",
          "name": "WooCommerce"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// zone_name（大小写不敏感）→ zone_id；未匹配的记 warning 跳过\nconst task = $('记模板ID').first().json;\nconst zones = $input.all().map(i => i.json);\nconst out = [];\nconst warnings = [];\nfor (const rate of task.zone_rates) {\n  const zone = zones.find(z => String(z.name || '').trim().toLowerCase() === String(rate.zone_name || '').trim().toLowerCase());\n  if (!zone) { warnings.push(`区域未找到: ${rate.zone_name}`); continue; }\n  out.push({ json: { job_id: task.job_id, token: task.token, callback_url: task.callback_url, woo_class_id: task.woo_class_id, zone_id: zone.id, base_cost: rate.base_cost, class_cost: rate.class_cost, warnings } });\n}\nif (!out.length) {\n  out.push({ json: { job_id: task.job_id, token: task.token, callback_url: task.callback_url, woo_class_id: task.woo_class_id, zone_id: null, warnings } });\n}\nreturn out;"
      },
      "id": "ba111111-1111-4111-8111-11111111111a",
