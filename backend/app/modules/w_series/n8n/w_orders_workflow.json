{
  "id": "barongWorders001",
  "versionId": "c5000000-0000-4000-8000-000000000002",
  "name": "barong控制台-W系列-订单同步",
  "active": true,
  "settings": {},
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "c1111111-1111-4111-8111-111111111111",
      "name": "定时触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://barongyekhna.com/wp-json/wc/v3/orders?per_page=50&orderby=date&order=desc",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "c2222222-2222-4222-8222-222222222222",
      "name": "拉Woo订单",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "aPB82hXe9Rxdvyfo",
          "name": "WooCommerce"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Woo 订单 → 控制台 ingest 契约（upsert 幂等，只送 Woo 归属字段）\nconst orders = $input.all().map(i => i.json).filter(o => o && o.id);\nconst mapped = orders.map(o => ({\n  woo_order_id: o.id,\n  order_number: String(o.number || o.id),\n  woo_status: String(o.status || 'pending'),\n  customer_name: [((o.shipping||{}).first_name || (o.billing||{}).first_name || ''), ((o.shipping||{}).last_name || (o.billing||{}).last_name || '')].join(' ').trim() || null,\n  country: (o.shipping||{}).country || (o.billing||{}).country || null,\n  total: o.total || null,\n  currency: o.currency || null,\n  items_json: (o.line_items||[]).map(li => ({ name: li.name, qty: li.quantity, sku: li.sku || null })),\n  placed_at: o.date_created_gmt ? (o.date_created_gmt + 'Z') : null,\n}));\nreturn [{ json: { orders: mapped } }];"
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "转ingest格式",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://console_backend:8000/w/orders/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Ingest-Token",
              "value": "__W_ORDERS_INGEST_TOKEN__"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "c4444444-4444-4444-8444-444444444444",
      "name": "推控制台",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    }
  ],
  "connections": {
    "定时触发": {
      "main": [
        [
          {
            "node": "拉Woo订单",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "拉Woo订单": {
      "main": [
        [
          {
            "node": "转ingest格式",
