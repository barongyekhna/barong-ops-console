        }
      },
      "id": "a9999999-9999-4999-8999-999999999999",
      "name": "写图SEO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        1000,
        300
      ],
      "credentials": {
        "wordpressApi": {
          "id": "kaIcXMDT4cNA0GXm",
          "name": "Wordpress account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const pkg = $('取数-上架包').first().json;\nconst metas = $('拆图').all().map((i) => i.json);\nconst medias = $input.all().map((i) => i.json);\nconst p = pkg.product || {};\nconst price = p.price || {};\nconst stock = p.stock || {};\nconst desc = p.description || {};\nlet html = desc.html || '';\nconst gallery = [];\nmetas.forEach((m, idx) => {\n  const media = medias[idx] || {};\n  if (m.placement === 'description' && m.embed_token) {\n    if (media.source_url) {\n      html = html.split(m.embed_token).join(media.source_url);\n    }\n  } else if (media.id != null) {\n    gallery.push({ id: media.id });\n  }\n});\nconst leftover = (html.match(/\\{\\{KP_IMG_\\d+\\}\\}/g) || []);\nif (leftover.length) throw new Error('描述图占位符未替换: ' + leftover.join(','));\nconst body = {\n  name: p.title || '',\n  type: 'simple',\n  status: 'draft',\n  sku: p.sku || '',\n  regular_price: price.regular != null ? String(price.regular) : '',\n  description: html,\n  short_description: '',\n  manage_stock: false,\n  stock_status: stock.status === 'out_of_stock' ? 'outofstock' : 'instock',\n  images: gallery,\n  meta_data: [],\n};\nif (price.sale != null) body.sale_price = String(price.sale);\n// 运费类映射：上架包 shipping.shipping_class = W-S 运费模板 slug，\n// Woo REST 产品的 shipping_class 字段直接吃 slug 字符串。\n// 没带 slug 就不写字段（保持 Woo 现值，避免覆盖手工设置）。\nconst shipping = pkg.shipping || {};\nif (shipping.shipping_class) {\n  body.shipping_class = String(shipping.shipping_class);\n}\n// FAQ 存产品 meta —— 站点侧 functions.php 读它输出 FAQPage schema\n// (description 里不能放 <script>，WP 会剥标签泄漏 JSON 文本)。\nconst faq = Array.isArray(desc.faq) ? desc.faq : [];\nif (faq.length) {\n  body.meta_data.push({ key: '_kp_faq', value: JSON.stringify(faq) });\n}\nreturn [{ json: { woo_body: body } }];"
      },
      "id": "a3333333-3333-4333-8333-333333333333",
