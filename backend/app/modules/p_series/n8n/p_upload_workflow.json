              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "a7777777-7777-4777-8777-777777777777",
      "name": "下载图",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
