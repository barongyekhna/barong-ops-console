    {
      "parameters": {
        "jsCode": "const pkg = $input.first().json;\nconst images = ((pkg.product || {}).images) || [];\nif (!images.length) throw new Error('上架包里没有图片（v2 契约 images 为空）');\nreturn images.map((img) => ({ json: img }));"
      },
      "id": "a6666666-6666-4666-8666-666666666666",
