    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://barongyekhna.com/wp-json/wp/v2/media/' + $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "wordpressApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $('拆图').item.json.title || '', alt_text: $('拆图').item.json.alt || '', caption: $('拆图').item.json.caption || '', description: $('拆图').item.json.description || '' }) }}",
        "options": {
