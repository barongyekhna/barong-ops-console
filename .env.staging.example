# Staging placeholder values only.
# Copy this file to .env.staging during C02C and edit it on the server.
# The real .env.staging file stays server-local and must not be committed.
#
# Staging must not reuse production secrets or passwords:
# - AUTH_TOKEN_SECRET must be different from production.
# - POSTGRES_PASSWORD must be different from production.
# - OWNER_PASSWORD must be a test owner password, not the production owner password.
# - N8N_TEST_WEBHOOK_URL stays empty by default to avoid touching real n8n.

APP_NAME=barong-ops-console-backend
APP_ENV=staging
APP_DEBUG=false
APP_VERSION=0.1.0

# POSTGRES_PASSWORD and the password inside DATABASE_URL must match.
# URL-encode special characters in DATABASE_URL passwords.
POSTGRES_DB=barong_ops_console_staging
POSTGRES_USER=barong_ops_console_staging
POSTGRES_PASSWORD=CHANGE-ME-staging-postgres-password-different-from-production
DATABASE_URL=postgresql+psycopg://barong_ops_console_staging:CHANGE-ME-url-encoded-staging-postgres-password@console_staging_postgres:5432/barong_ops_console_staging

# Must be a strong random value, at least 32 bytes, and not copied from production.
AUTH_TOKEN_SECRET=CHANGE-ME-staging-token-secret-different-from-production
AUTH_TOKEN_EXPIRE_MINUTES=60

# Use a staging-only test owner. Do not reuse the production owner password.
OWNER_USERNAME=staging_owner
OWNER_PASSWORD=CHANGE-ME-staging-test-owner-password-not-production

# Server-side container URL used by the Next.js API proxy.
BACKEND_API_URL=http://console_staging_backend:8000

# Browser-visible staging console origin. This is not a secret.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3100

# Keep these empty unless a separate approved test/demo n8n workflow exists.
# Never point staging at a real production n8n business workflow.
N8N_TEST_WEBHOOK_URL=
N8N_TEST_CALLBACK_SECRET=
N8N_TEST_REQUEST_TIMEOUT_SECONDS=10

# C16-FIX-4 staging security hardening defaults.
WEBHOOK_REPLAY_NONCE_TTL_SECONDS=900
LOGIN_IP_RATE_LIMIT_ATTEMPTS=20
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_FAILED_ATTEMPT_LOCKOUT_THRESHOLD=5
LOGIN_FAILED_ATTEMPT_BASE_DELAY_SECONDS=2
LOGIN_FAILED_ATTEMPT_MAX_DELAY_SECONDS=60
LOGIN_ACCOUNT_LOCKOUT_MINUTES=15
