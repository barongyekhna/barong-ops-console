# C19 Asset Service placeholders only. Copy to `.env.c19-asset.production`,
# set mode 0600, replace every CHANGE-ME value and never commit or print it.

C19_ASSET_DATASET_ID=barong-c19-assets-production
POSTGRES_DB=c19_chat_assets
POSTGRES_USER=c19_asset_service
# Use one URL-safe random value (for example, hex) in both password locations.
POSTGRES_PASSWORD=CHANGE-ME-same-url-safe-c19-asset-postgres-password
C19_ASSET_DATABASE_URL=postgresql+psycopg://c19_asset_service:CHANGE-ME-same-url-safe-c19-asset-postgres-password@c19-asset-postgres:5432/c19_chat_assets

# This value must match C19_ASSET_STORE_TOKEN in Barong `.env.production`.
C19_ASSET_SERVICE_TOKEN=CHANGE-ME-independent-barong-to-asset-service-token
# Shared only by Asset API and byte gateway; Barong never receives this value.
C19_ASSET_GATEWAY_TOKEN=CHANGE-ME-independent-asset-gateway-token

C19_ASSET_UPLOAD_TICKET_TTL_SECONDS=600
C19_ASSET_DOWNLOAD_TICKET_TTL_SECONDS=60
C19_ASSET_DOWNLOAD_TICKET_MAX_USES=12
C19_ASSET_MAX_PENDING_PER_OWNER=8
C19_ASSET_MAX_UPLOAD_TICKETS_PER_ASSET=8
C19_ASSET_DATABASE_WORKERS=4
C19_ASSET_IMAGE_MAX_BYTES=20971520
C19_ASSET_FILE_MAX_BYTES=52428800
# Durable metadata quotas count every non-deleted asset. Reserved bytes use
# actual bytes when known (otherwise declared bytes) plus thumbnail bytes.
C19_ASSET_THUMBNAIL_MAX_BYTES=2097152
C19_ASSET_OWNER_RESERVED_FILE_LIMIT=2000
C19_ASSET_OWNER_RESERVED_BYTE_LIMIT=2147483648
C19_ASSET_GLOBAL_RESERVED_FILE_LIMIT=100000
C19_ASSET_GLOBAL_RESERVED_BYTE_LIMIT=53687091200
C19_ASSET_HARD_MAX_BYTES=67108864
C19_ASSET_IMAGE_MAX_PIXELS=40000000
C19_ASSET_IMAGE_MAX_DIMENSION=20000
C19_ASSET_IMAGE_MAX_FRAMES=500
C19_ASSET_IMAGE_MAX_TOTAL_FRAME_PIXELS=100000000
C19_ASSET_ARCHIVE_MAX_MEMBERS=2000
C19_ASSET_ARCHIVE_MAX_UNPACKED_BYTES=268435456
C19_ASSET_ARCHIVE_MAX_RATIO=100
C19_ASSET_WORKER_POLL_SECONDS=1
C19_ASSET_CLAMD_SIGNATURE_MAX_AGE_HOURS=48
C19_ASSET_UNBOUND_TTL_HOURS=24
C19_ASSET_ORPHAN_GRACE_HOURS=24

C19_ASSET_INCOMING_ROOT=/var/lib/c19-assets/incoming
C19_ASSET_QUARANTINE_ROOT=/var/lib/c19-assets/quarantine
C19_ASSET_ACTIVE_ROOT=/var/lib/c19-assets/active
C19_ASSET_CLAMD_HOST=c19-asset-clamd
C19_ASSET_CLAMD_PORT=3310
C19_ASSET_API_URL=http://c19-asset-api:8091
